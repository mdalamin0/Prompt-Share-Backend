{
  "version": 2,
  "builds": [
    {
      "src": "dist/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/chat/send-message",
      "dest": "dist/server.js",
      "headers": {
        "X-Accel-Buffering": "no",
        "Cache-Control": "no-cache, no-transform",
        "Connection": "keep-alive"
      }
    },
    {
      "src": "/(.*)",
      "dest": "dist/server.js"
    }
  ]
}